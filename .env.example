# NODE url
XRPL_JSON_RPC_URL=https://s1.ripple.com:51234/

# Database Configuration
# Options: postgresql, sqlite
DATABASE_TYPE=postgresql
# For SQLite, use: DATABASE_URL=sqlite:///xrpl_indexer.db

# PostgreSQL individual credentials (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=xrpl_user
DB_PASSWORD=your_password_here
DB_NAME=xrpl_indexer

# Indexer Scheduler Configuration
CRON_INTERVAL_MINUTES=5

# Parallel Processing (Optional - Disabled by default)
# WARNING: Only enable if you have no rate limits and need to sync faster
# Set to "true" to enable parallel ledger processing
ENABLE_PARALLEL_PROCESSING=false
# Number of concurrent workers (default: 5)
# Higher values = faster processing but more API calls
PARALLEL_WORKERS=5

# Wallet Discovery
# Legacy single funding wallet. Existing installations can keep using it.
CENTRAL_WALLET_ADDRESS=
# Additional funding wallets (comma-separated). A Payment from any configured
# parent enrolls its destination when it creates a new XRPL account.
PARENT_WALLET_ADDRESSES=
# SourceTags (comma-separated integers) that also qualify a Payment to enroll
# its newly activated destination, regardless of the funding wallet.
# Every transaction with one of these tags is stored even if FILTER_* excludes it.
TRACK_SOURCE_TAGS=

# Monitoring (optional)
# The monitor always checks the API over localhost. Set the public URL as well
# to catch DNS, TLS, reverse-proxy, and security-group failures.
MONITOR_LOCAL_HEALTH_URL=http://127.0.0.1:8000/health
MONITOR_LOCAL_STATUS_URL=http://127.0.0.1:8000/status
MONITOR_PUBLIC_HEALTH_URL=
MONITOR_INTERVAL_SECONDS=60
MONITOR_INDEXER_STALE_SECONDS=900
MONITOR_MEMORY_WARN_PERCENT=85
MONITOR_DISK_WARN_PERCENT=85
# Generic JSON webhook for monitor warning/recovery transitions (Slack-compatible).
# This does not report individual transactions or PostgreSQL backup failures.
MONITOR_WEBHOOK_URL=

# Transaction Filters (Optional)
# Leave empty to index all transactions

# Filter by transaction types (comma-separated)
# Examples: Payment,NFTokenMint,OfferCreate,TrustSet
FILTER_TRANSACTION_TYPES=

# Filter by addresses (comma-separated)
# Examples: rN7n7otQDd6FczFgLdlqtyMVrn3eBsePke,rPEPPER7kfTD9w2To4CQk6UCfuHM9c6GDY
FILTER_ADDRESSES=

# Filter by source tags (comma-separated integers)
# This only filters ordinary transaction storage; it does not discover wallets.
# Examples: 123,456,789
FILTER_SOURCE_TAGS=
